# Copy to android/keystore.properties (which git ignores) and fill in.
# The keystore file itself is ignored too (*.keystore); the path is relative
# to android/app/.
MYAPP_UPLOAD_STORE_FILE=my-vokve-upload-key.keystore
MYAPP_UPLOAD_KEY_ALIAS=my-vokve-key-alias
MYAPP_UPLOAD_STORE_PASSWORD=
MYAPP_UPLOAD_KEY_PASSWORD=
