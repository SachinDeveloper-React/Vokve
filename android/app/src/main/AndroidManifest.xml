<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Health Connect, read only. Step counting itself (ACTIVITY_RECOGNITION,
      the health foreground service, boot restart) is declared by
      react-native-step-tracker-pro's own manifest. These two let it read a
      watch or another app's steps and distance for the same day; Vokve never
      writes to Health Connect, so no WRITE_* is declared. Background reads
      need no READ_HEALTH_DATA_IN_BACKGROUND while tracking is on: the
      tracking service is a foreground service, which Health Connect treats
      as foreground.
    -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />

    <!--
      Taking a profile photo. The picker needs no storage permission: on
      Android 13+ the photo picker returns one image the user chose without
      granting the app the gallery, and below that the library's own
      document intent does the same.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
      android:enableOnBackInvokedCallback="false"
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!--
        Health Connect's "why does this app want health data?" link - the
        ACTION_SHOW_PERMISSIONS_RATIONALE activity and the
        VIEW_PERMISSION_USAGE alias Play requires - comes from
        react-native-step-tracker-pro's manifest. It opens the
        privacyPolicyUrl given to StepTracker.initialize() (services/steps).
        Exactly one activity may answer each, so none is declared here.
      -->
    </application>
</manifest>
