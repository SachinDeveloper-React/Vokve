<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Hydration reminders (RULES Y6) are local alarms, scheduled by notifee
      from the plan in services/notifications. Everything they need is
      declared by notifee's own manifest and merged in here: VIBRATE,
      SCHEDULE_EXACT_ALARM, WAKE_LOCK, RECEIVE_BOOT_COMPLETED, and the
      receiver that re-schedules the alarms after a restart - which is why
      a phone that reboots overnight still rings at seven. Nothing is
      repeated below: a permission declared twice is not stronger, and the
      one place to change it should be the library that uses it.

      Not declared, deliberately: USE_EXACT_ALARM. It would grant exact
      alarms without asking, but Play only allows it for apps whose main
      purpose is alarms or calendars, and a hydration reminder is not that.
      So the app asks for SCHEDULE_EXACT_ALARM instead and falls back to
      inexact alarms if it is refused, saying so on the reminder screen.
    -->

    <!--
      Health Connect. Step counting itself (ACTIVITY_RECOGNITION, the health
      foreground service, boot restart) is declared by
      react-native-step-tracker-pro's own manifest. The two reads let it use
      a watch or another app's steps and distance for the same day. WRITE_STEPS
      puts the steps this phone counts into Health Connect for the user's
      other fitness apps (D-57) - steps only: Vokve's distance and calories
      are estimates, so WRITE_DISTANCE and WRITE_TOTAL_CALORIES_BURNED are
      left out, and the tracker does not ask for them. Background reads need
      no READ_HEALTH_DATA_IN_BACKGROUND while tracking is on: the tracking
      service is a foreground service, which Health Connect treats as
      foreground.
    -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.WRITE_STEPS" />

    <!--
      Taking a profile photo. The picker needs no storage permission: on
      Android 13+ the photo picker returns one image the user chose without
      granting the app the gallery, and below that the library's own
      document intent does the same.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
      android:enableOnBackInvokedCallback="false"
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <!--
        No launcher entry of its own: the icon on the home screen is one of
        the aliases below, each pointing here with its own icon. Exactly one
        is enabled at a time; the vokve-app-icon module swaps them when the
        server picks another icon (RULES DV13). Still exported, so an
        explicit start (`react-native run-android`, adb) reaches it.
      -->
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true" />

      <!-- app-icons:start — written by scripts/write-app-icons.mjs; edit assets/app-icons/catalog.json, not this. -->
      <activity-alias
        android:name=".AppIconRedfield"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enabled="true"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.vokve.appicon.KEY" android:value="redfield" />
      </activity-alias>
      <activity-alias
        android:name=".AppIconClassic"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_classic"
        android:roundIcon="@mipmap/ic_launcher_classic"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.vokve.appicon.KEY" android:value="classic" />
      </activity-alias>
      <activity-alias
        android:name=".AppIconNight"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_night"
        android:roundIcon="@mipmap/ic_launcher_night"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.vokve.appicon.KEY" android:value="night" />
      </activity-alias>
      <activity-alias
        android:name=".AppIconChristmas"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_christmas"
        android:roundIcon="@mipmap/ic_launcher_christmas"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.vokve.appicon.KEY" android:value="christmas" />
      </activity-alias>
      <activity-alias
        android:name=".AppIconDiwali"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_diwali"
        android:roundIcon="@mipmap/ic_launcher_diwali"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.vokve.appicon.KEY" android:value="diwali" />
      </activity-alias>
      <activity-alias
        android:name=".AppIconEid"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_eid"
        android:roundIcon="@mipmap/ic_launcher_eid"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.vokve.appicon.KEY" android:value="eid" />
      </activity-alias>
      <activity-alias
        android:name=".AppIconHoli"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_holi"
        android:roundIcon="@mipmap/ic_launcher_holi"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.vokve.appicon.KEY" android:value="holi" />
      </activity-alias>
      <activity-alias
        android:name=".AppIconIndependence"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_independence"
        android:roundIcon="@mipmap/ic_launcher_independence"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.vokve.appicon.KEY" android:value="independence" />
      </activity-alias>
      <activity-alias
        android:name=".AppIconNewyear"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_newyear"
        android:roundIcon="@mipmap/ic_launcher_newyear"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.vokve.appicon.KEY" android:value="newyear" />
      </activity-alias>
      <!-- app-icons:end -->

      <!--
        The status-bar glyph for a push FCM shows by itself (one that
        arrives while the app is not running). Without it Android draws the
        launcher icon, which a status bar turns into a white square. Its
        tint is `messaging_android_notification_color` in firebase.json:
        @react-native-firebase/messaging declares that meta-data itself, so
        declaring it here too would be a manifest-merge conflict.
      -->
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_icon"
        android:resource="@drawable/ic_notification" />

      <!--
        Health Connect's "why does this app want health data?" link - the
        ACTION_SHOW_PERMISSIONS_RATIONALE activity and the
        VIEW_PERMISSION_USAGE alias Play requires - comes from
        react-native-step-tracker-pro's manifest. It opens the
        privacyPolicyUrl given to StepTracker.initialize() (services/steps).
        Exactly one activity may answer each, so none is declared here.
      -->
    </application>
</manifest>
