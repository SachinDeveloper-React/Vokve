<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Hydration reminders (RULES Y6) are local alarms, scheduled by notifee
      from the plan in services/notifications. Everything they need is
      declared by notifee's own manifest and merged in here: VIBRATE,
      SCHEDULE_EXACT_ALARM, WAKE_LOCK, RECEIVE_BOOT_COMPLETED, and the
      receiver that re-schedules the alarms after a restart - which is why
      a phone that reboots overnight still rings at seven. Nothing is
      repeated below: a permission declared twice is not stronger, and the
      one place to change it should be the library that uses it.

      Not declared, deliberately: USE_EXACT_ALARM. It would grant exact
      alarms without asking, but Play only allows it for apps whose main
      purpose is alarms or calendars, and a hydration reminder is not that.
      So the app asks for SCHEDULE_EXACT_ALARM instead and falls back to
      inexact alarms if it is refused, saying so on the reminder screen.
    -->

    <!--
      Health Connect. Step counting itself (ACTIVITY_RECOGNITION, the health
      foreground service, boot restart) is declared by
      react-native-step-tracker-pro's own manifest. The two reads let it use
      a watch or another app's steps and distance for the same day. WRITE_STEPS
      puts the steps this phone counts into Health Connect for the user's
      other fitness apps (D-57) - steps only: Vokve's distance and calories
      are estimates, so WRITE_DISTANCE and WRITE_TOTAL_CALORIES_BURNED are
      left out, and the tracker does not ask for them. Background reads need
      no READ_HEALTH_DATA_IN_BACKGROUND while tracking is on: the tracking
      service is a foreground service, which Health Connect treats as
      foreground.
    -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.WRITE_STEPS" />

    <!--
      Taking a profile photo. The picker needs no storage permission: on
      Android 13+ the photo picker returns one image the user chose without
      granting the app the gallery, and below that the library's own
      document intent does the same.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
      android:enableOnBackInvokedCallback="false"
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!--
        Health Connect's "why does this app want health data?" link - the
        ACTION_SHOW_PERMISSIONS_RATIONALE activity and the
        VIEW_PERMISSION_USAGE alias Play requires - comes from
        react-native-step-tracker-pro's manifest. It opens the
        privacyPolicyUrl given to StepTracker.initialize() (services/steps).
        Exactly one activity may answer each, so none is declared here.
      -->
    </application>
</manifest>
