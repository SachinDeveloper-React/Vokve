{
  "name": "vokve-app-icon",
  "version": "1.0.0",
  "private": true,
  "description": "Switches VOKVE's launcher icon among the ones the build carries: activity aliases on Android, alternate icons on iOS.",
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "types": "src/index.ts",
  "license": "UNLICENSED",
  "author": "VOKVE",
  "homepage": "https://vokve.com",
  "repository": { "type": "git", "url": "https://vokve.com" },
  "peerDependencies": {
    "react-native": ">=0.79.0"
  },
  "codegenConfig": {
    "name": "VokveAppIconSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.vokve.appicon"
    },
    "ios": {
      "modulesProvider": {
        "VokveAppIcon": "VokveAppIconModule"
      }
    }
  }
}
