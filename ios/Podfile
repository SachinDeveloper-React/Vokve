# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported

# RN's cocoapods scripts branch on this env var in several places (modulemaps,
# search paths, prebuilt core setup). Set it here so every script agrees with
# the `use_frameworks!` call below instead of only the target definition knowing.
ENV['USE_FRAMEWORKS'] ||= 'static'

# @react-native-firebase >= 26 defaults to resolving firebase-ios-sdk through SPM
# on RN >= 0.75, and SPM mode hard-requires `:linkage => :dynamic`. Dynamic
# linkage is incompatible with RN 0.87's prebuilt React.xcframework (static), and
# react-native-fbsdk-next does not link under dynamic frameworks either. So: opt
# out of SPM and let CocoaPods resolve Firebase.
$RNFirebaseDisableSPM = true
$RNFirebaseAsStaticFramework = true

prepare_react_native_project!

# Pods whose podspec relies on the app binary to pull in a system framework
# implicitly. Keyed by pod target name; see the note on each entry for what it
# fixes.
MISSING_SYSTEM_FRAMEWORKS = {
  # RNCClipboard.mm imports <MobileCoreServices/UTType.h> for UTTypeConformsTo,
  # UTTypeCopyPreferredTagWithClass, kUTTypeImage and kUTTagClassMIMEType, but
  # RNCClipboard.podspec declares no `s.ios.frameworks`.
  'RNCClipboard' => ['MobileCoreServices'],
}.freeze

def link_missing_system_frameworks!(installer)
  installer.pods_project.targets.each do |target|
    frameworks = MISSING_SYSTEM_FRAMEWORKS[target.name]
    next if frameworks.nil?

    target.build_configurations.each do |config|
      flags = config.build_settings['OTHER_LDFLAGS'] || ['$(inherited)']
      flags = flags.split(/\s+/) if flags.is_a?(String)

      frameworks.each do |framework|
        next if flags.include?(framework)
        flags += ['-framework', framework]
      end

      config.build_settings['OTHER_LDFLAGS'] = flags
    end
  end
end

# Xcode 26 rejects any deployment target below 15.0. `react_native_post_install`
# raises the floor on pod targets, but not on the resource bundle targets
# CocoaPods generates for them (*_Privacy, RNSVGFilters, ...), which inherit the
# vendor podspec's own floor — 9.0 for PromisesObjC, 12.0 for the Google pods.
# Clamp everything in the Pods project to the project's minimum.
def fix_deployment_targets!(installer)
  minimum = Gem::Version.new(min_ios_version_supported)

  projects = installer.aggregate_targets
    .map { |t| t.user_project }
    .uniq
    .push(installer.pods_project)
    .compact

  projects.each do |project|
    project.build_configurations.each do |config|
      current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if current.nil? || Gem::Version.new(current) < minimum
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
      end
    end

    project.targets.each do |target|
      target.build_configurations.each do |config|
        current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        next if current.nil? # inherits from the project level, already handled
        if Gem::Version.new(current) < minimum
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
        end
      end
    end

    project.save
  end
end

target 'vokve' do
  config = use_native_modules!

  use_frameworks! :linkage => :static

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    link_missing_system_frameworks!(installer)
    fix_deployment_targets!(installer)
  end
end