NODE_ENV=development
PORT=3000
# Local replica set from docker-compose (transactions need a replica set).
MONGODB_URI=mongodb://localhost:27017/vokve?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
# Dev only: OTP codes are returned in the response, logged, and shown on the app's OTP screen. Refused in production.
OTP_DEV_ECHO=true

# Email OTP over SMTP. For Gmail: enable 2-step verification, create an App Password
# (Google Account → Security → App passwords), then:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<16-char app password>
#   MAIL_FROM="VOKVE <you@gmail.com>"
# Leave unset and codes are only logged/echoed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
LOG_LEVEL=debug
