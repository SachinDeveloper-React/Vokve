NODE_ENV=development
PORT=3000
# Local replica set from docker-compose (transactions need a replica set).
MONGODB_URI=mongodb://localhost:27017/vokve?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
# Dev only: OTP codes are returned in the response, logged, and shown on the app's OTP screen. Refused in production.
OTP_DEV_ECHO=true
# The developer endpoints (POST /dev/steps writes a day's verified steps, POST
# /dev/jobs/* runs the jobs). Off in production by NODE_ENV; set false to
# refuse them whatever NODE_ENV says.
DEV_ROUTES=true

# Email OTP over SMTP. For Gmail: enable 2-step verification, create an App Password
# (Google Account → Security → App passwords), then:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<16-char app password>
#   MAIL_FROM="VOKVE <you@gmail.com>"
# Leave unset and codes are only logged/echoed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
LOG_LEVEL=debug

# Push (FCM). The service account as its three fields, taken straight out of
# the JSON Firebase hands you (Project settings -> Service accounts -> Generate
# new private key): `project_id`, `client_email`, `private_key`. Absent = no
# push channel: notifications are feed rows only, sends log push.no_provider,
# and the step sync nudge (RULES A28) does not run at all.
#
# The private key is a PEM. Keep it on one line, in double quotes, with its
# newlines written as \n — exactly as the JSON has it. That is the form a
# hosting panel (Vercel, Render, a container's --env-file) can hold too, and
# the server turns it back into a real key on boot.
# FIREBASE_PROJECT_ID=vokve-xxxxx
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@vokve-xxxxx.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
#
# Or, instead of the three above, the whole JSON in one variable — or an
# absolute path to the file. Kept for deployments that already do it that way;
# the three keys win when both are set. The downloaded file belongs in
# `vokve-backend/secrets/`, which is gitignored — never in `android/app/`,
# which is the client; on a server, keep it outside the checkout.
# FIREBASE_SERVICE_ACCOUNT=/etc/vokve/firebase-service-account.json
# Where referral links point (the page redirects to the store until deep links exist).
# SHARE_URL_BASE=https://vokve.app/r

# Payments — who collects the money side of an order. `mock` captures every
# payment at once and is refused in production; `razorpay` needs both keys
# (dashboard → Settings → API Keys). Card, UPI and net banking all come
# through the one gateway.
PAYMENT_PROVIDER=mock
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# This API's own public origin. Used to build the absolute URLs it hands out
# for media it serves (avatars). Behind a proxy, the public address.
PUBLIC_BASE_URL=http://localhost:3000

# Step integrity (Phase 2). Play Integrity: a service account that may call
# decodeIntegrityToken, and the Cloud project linked to the app in Play
# Console. Without them no verdict is asked for. Same three fields, same
# one-line PEM rule as the Firebase keys above; PLAY_INTEGRITY_SERVICE_ACCOUNT
# (the JSON, or a path to it) still works as the single-variable form.
# PLAY_INTEGRITY_PROJECT_ID=vokve-xxxxx
# PLAY_INTEGRITY_CLIENT_EMAIL=play-integrity@vokve-xxxxx.iam.gserviceaccount.com
# PLAY_INTEGRITY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
# PLAY_INTEGRITY_SERVICE_ACCOUNT=/etc/vokve/play-integrity-service-account.json
# PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=123456789012
# Google's key attestation revocation list; empty turns the check off.
# ATTESTATION_STATUS_URL=https://android.googleapis.com/attestation/status

# The operator's key for the admin HTTP API (/v1/admin/*), which is how diet
# plans are written. Unset = no admin surface at all: every /v1/admin route
# answers 404. At least 24 characters; send it as `X-Admin-Key`.
# ADMIN_API_KEY=change-me-to-a-long-random-admin-key
# Who the audit log records for admin writes.
# ADMIN_ACTOR=admin
