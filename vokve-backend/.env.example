NODE_ENV=development
PORT=3000
# Reverse proxies between the internet and this process: how many entries at
# the end of X-Forwarded-For to believe when working out the caller's address
# for the per-IP rate limits. 1 for a single platform proxy (Vercel, Render,
# one nginx), 2 with a CDN in front of it, 0 when nothing is in front.
# TRUST_PROXY_HOPS=1
# Local replica set from docker-compose (transactions need a replica set).
MONGODB_URI=mongodb://localhost:27017/vokve?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379
# At least 32 random characters in production (`openssl rand -base64 48`);
# a placeholder like this one is refused at boot there.
JWT_SECRET=change-me-to-a-long-random-string
# Rotating it: move the old value here, put a new one in JWT_SECRET, deploy,
# and delete this line 12 hours later (the longest an admin session lasts).
# JWT_SECRET_PREVIOUS=
# Browser origins allowed to read API answers (CORS), comma separated. The app
# is native and the panel calls from its server, so production needs none:
# unset there means no origin at all (avatars under /v1/media stay open).
# CORS_ORIGINS=https://admin.vokve.com
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
# Dev only: OTP codes are returned in the response, logged, and shown on the app's OTP screen. Refused in production.
OTP_DEV_ECHO=true
# The developer endpoints (POST /dev/steps writes a day's verified steps, POST
# /dev/jobs/* runs the jobs). Off in production by NODE_ENV; set false to
# refuse them whatever NODE_ENV says.
DEV_ROUTES=true

# Email OTP over SMTP. For Gmail: enable 2-step verification, create an App Password
# (Google Account → Security → App passwords), then:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<16-char app password>
#   MAIL_FROM="VOKVE <you@gmail.com>"
# Leave unset and codes are only logged/echoed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# The SMTP account's daily sending limit, for an alarm at 80% of it (RULES P20).
# Personal Gmail stops at ~500 a day and then refuses every OTP for up to 24h;
# with SMTP_HOST=smtp.gmail.com and this blank, 500 is assumed. Set it for
# anything else: Google Workspace 2000, Amazon SES your account's quota.
MAIL_DAILY_LIMIT=

# Where the alarms go (RULES P19, P20):
#   - the server: a 500 (first one per route, at once), OTP email failing (at
#     once), OTP email at 80% of its daily limit;
#   - the fleet, hourly: a build that has started crashing, step services being
#     killed, uploads that have stopped, pushes never delivered, wrong clocks.
# Each key is raised at most once an hour. `npm run alerts:test` sends a test one.
#
# Telegram (recommended — free, on your phone): @BotFather → /newbot gives the
# token; send your new bot any message, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": …}.
#   OPS_TELEGRAM_BOT_TOKEN=123456789:AA...
#   OPS_TELEGRAM_CHAT_ID=987654321
# Webhook: posts { "text", "content" } — Slack, Discord, Google Chat all accept it.
#   OPS_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Email goes through the SMTP above, so it CANNOT tell you that SMTP has failed.
# Use it beside Telegram or a webhook, never alone.
#   OPS_EMAIL=ops@yourdomain.com
OPS_TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=
OPS_WEBHOOK_URL=
OPS_EMAIL=

LOG_LEVEL=debug
# auto = coloured one-line logs in a terminal (errors red, warnings orange,
# success green, every request with method, path, status, time and error
# code), JSON when piped or on a host. Force either with pretty / json.
LOG_FORMAT=auto

# Push (FCM). The service account as its three fields, taken straight out of
# the JSON Firebase hands you (Project settings -> Service accounts -> Generate
# new private key): `project_id`, `client_email`, `private_key`. Absent = no
# push channel: notifications are feed rows only, sends log push.no_provider,
# and the step sync nudge (RULES A28) does not run at all.
#
# The private key is a PEM. Keep it on one line, in double quotes, with its
# newlines written as \n — exactly as the JSON has it. That is the form a
# hosting panel (Vercel, Render, a container's --env-file) can hold too, and
# the server turns it back into a real key on boot.
# FIREBASE_PROJECT_ID=vokve-xxxxx
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@vokve-xxxxx.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
#
# Or, instead of the three above, the whole JSON in one variable — or an
# absolute path to the file. Kept for deployments that already do it that way;
# the three keys win when both are set. The downloaded file belongs in
# `vokve-backend/secrets/`, which is gitignored — never in `android/app/`,
# which is the client; on a server, keep it outside the checkout.
# FIREBASE_SERVICE_ACCOUNT=/etc/vokve/firebase-service-account.json

# Payments — who collects the money side of an order. `mock` captures every
# payment at once and is refused in production; `razorpay` needs both keys
# (dashboard → Settings → API Keys). Card, UPI and net banking all come
# through the one gateway.
PAYMENT_PROVIDER=mock
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# This API's own public origin. Used to build the absolute URLs it hands out
# for media it serves (avatars). Behind a proxy, the public address.
PUBLIC_BASE_URL=http://localhost:3000

# The public website's refresh hook. With both set, a contact detail changed
# on the panel's Contact & links page shows on vokve.com at once; without
# them the site picks it up within the hour it caches for. The secret is the
# site's CONTENT_REVALIDATE_SECRET.
# SITE_REVALIDATE_URL=https://vokve.com/api/revalidate
# SITE_REVALIDATE_SECRET=

# Step integrity (Phase 2). Play Integrity: a service account that may call
# decodeIntegrityToken, and the Cloud project linked to the app in Play
# Console. Without them no verdict is asked for. Same three fields, same
# one-line PEM rule as the Firebase keys above; PLAY_INTEGRITY_SERVICE_ACCOUNT
# (the JSON, or a path to it) still works as the single-variable form.
# PLAY_INTEGRITY_PROJECT_ID=vokve-xxxxx
# PLAY_INTEGRITY_CLIENT_EMAIL=play-integrity@vokve-xxxxx.iam.gserviceaccount.com
# PLAY_INTEGRITY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
# PLAY_INTEGRITY_SERVICE_ACCOUNT=/etc/vokve/play-integrity-service-account.json
# PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=123456789012
# Google's key attestation revocation list; empty turns the check off.
# ATTESTATION_STATUS_URL=https://android.googleapis.com/attestation/status

# The operator's key for the admin HTTP API (/v1/admin/*), which is how diet
# plans are written. Unset = no admin surface at all: every /v1/admin route
# answers 404. Use `openssl rand -base64 36` (production warns under 32
# characters). The panel trades it at POST /v1/admin/session for a 12-hour
# session; scripts may still send it as `X-Admin-Key` while no TOTP is set.
# Twenty wrong keys from one address lock that address out for 15 minutes.
# ADMIN_API_KEY=change-me-to-a-long-random-admin-key
# Who the audit log records for admin writes.
# ADMIN_ACTOR=admin
# The operator's second factor (RULES Z7): a base32 TOTP secret from
# `npm run admin:totp`, enrolled in an authenticator app. Set, the panel asks
# for the six-digit code at sign-in and the bare key opens nothing.
# ADMIN_TOTP_SECRET=

# The **web** OAuth client id Google ID tokens are checked against
# (RULES O12). Web, even though the tokens come from Android and iOS: that
# is the audience the native SDKs put in a token when they are configured
# with `webClientId`, and it is the one value that says "this token was
# minted for us". An *Android* client id here is the commonest cause of a
# sign-in that works in debug and fails in release.
#
# Unset and POST /auth/google answers 503 rather than accepting anything.
GOOGLE_WEB_CLIENT_ID=
#
# Comma-separate them when the two bundled files disagree: read
# `default_web_client_id` out of android/app/google-services.json (the
# client_type 3 entry) and WEB_CLIENT_ID out of
# ios/GoogleService-Info.plist. A Firebase project whose Android and iOS
# apps were added at different times carries a different web client in
# each, so the platforms mint different audiences and listing only one
# breaks sign-in on the other platform with nothing but "token invalid".

# Who an Apple identity token may be addressed to (RULES O13): a
# comma-separated list, each entry matched exactly against the token's
# `aud`. Two kinds of id, because the platforms sign in differently:
#   - the iOS **bundle id** (com.vokve.fitness) — iOS signs in natively and
#     Apple addresses the token to the app;
#   - the **Services ID** the Android app opens Apple's web flow with
#     (`appleServiceId` in the app's src/constants/config.ts).
# Unset and POST /auth/apple answers 503 rather than accepting anything.
APPLE_CLIENT_IDS=

# Revoking a member's Apple authorisation when they delete their account
# or disconnect Apple (App Store Review Guideline 5.1.1(v), RULES O16).
# developer.apple.com -> Keys -> + -> "Sign in with Apple", configured with
# the primary App ID (com.vokve.fitness). Download the .p8 once, then:
#   APPLE_TEAM_ID      the 10-character team id (top right of the portal)
#   APPLE_KEY_ID       the key's 10-character id
#   APPLE_PRIVATE_KEY  the .p8 contents on one line, newlines as \n
#   APPLE_REDIRECT_URI the Android app's appleRedirectUri, exactly
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=


FACEBOOK_APP_SECRET=
# Where catalogue images live (RULES R18). Member avatars stay in Mongo —
# one small square per account — but a product gallery is ten photos an item
# on a shelf everybody scrolls, and serving those from the database means
# paying for the read, the memory and the bandwidth every time.
#
# All four or none: a half-configured bucket is the worst of both, because
# the panel would offer an upload that fails at the last step, after the
# operator has already chosen the file. The bucket also needs a CORS rule
# allowing PUT from the panel's origin — the browser uploads straight to it.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# A CloudFront domain, or any CDN in front of the bucket. Unset serves
# straight from S3, which works and costs more per view than it needs to.
AWS_S3_PUBLIC_BASE=
